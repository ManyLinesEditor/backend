# Postgres (shared across services)
POSTGRES_USER=manylines
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Database names (one per service)
POSTGRES_DB=auth_db
STORAGE_DB=storage_db
PAYMENT_DB=payment_db

# Gateway
GATEWAY_PORT=8080
DATABASE_URL=postgres://manylines:change-me@postgres:5432/auth_db?sslmode=disable
TOKEN_SECRET=change-me-min-32-characters-long
TOKEN_TTL=720h
STORAGE_URL=http://storage-service:8081
PAYMENT_URL=http://payment-service:8082

# Storage
HTTP_ADDR=:8081
POSTGRES_DSN=postgres://manylines:change-me@postgres:5432/storage_db?sslmode=disable
TOKEN_TTL=720h

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=manylines-files
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# Payment
ACQUIREMOCK_URL=http://acquiremock:8000
PAYMENT_PORT=8082
WEBHOOK_SECRET=change-me-min-32-characters-long
BASE_URL=http://gateway:8080
